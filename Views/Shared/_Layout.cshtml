<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title | TechPulse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechPulse.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/icons/globe.png")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="light-mode d-flex flex-column vh-100">
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Logga in</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="loginForm" action="@Url.Action("Login", "Account")" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">E-post</label>
                            <input type="email" class="form-control" id="loginEmail" name="Email" required>
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Lösenord</label>
                            <input type="password" class="form-control" id="loginPassword" name="Password" required>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe">
                                <label class="form-check-label" for="rememberMe">Håll mig inloggad</label>
                            </div>
                            <a href="@Url.Action("ForgotPassword", "Account")" class="text-decoration-none">Glömt lösenord?</a>
                        </div>
                        <div id="loginError" class="alert alert-danger d-none"></div>
                        <button type="submit" class="btn btn-primary w-100">Logga in</button>
                    </form>
                    <div class="text-center mt-3">
                        <span>Har du inget konto? </span>
                        <a href="@Url.Action("Register", "Account")" class="text-decoration-none">Skapa konto</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-brand" href="@Url.Action("Index","Home")">Tech<span class="pulse-text">Pulse</span></span>
                </button>

                @{
                    var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";
                    var username = Context.Session.GetString("Username");
                    var profileImageUrl = isLoggedIn ?
                        (Context.Session.GetString("ProfileImageUrl") ?? "/images/default-profile.jpg") :
                        "/images/default-profile.jpg";
                }
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Product")">Produkter</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Privacy", "Home")">Privacy</a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center">
                        <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary me-2 position-relative">
                            <i class="bi bi-cart"></i>
                            @{
                                // Check if cart was just cleared
                                bool cartJustCleared = Context.Session.TryGetValue("CartCleared", out _);
                                
                                if (!cartJustCleared)
                                {
                                    var cart = TechPulse.Models.ShoppingCart.GetCart(Context.RequestServices);
                                    var itemCount = cart?.Items.Count ?? 0;
                                    if (itemCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartBadge">
                                            @itemCount
                                        </span>
                                    }
                                }
                            }
                        </a>
                        
                        @if (isLoggedIn)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@profileImageUrl" alt="Profile" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;">
                                    <span>@username</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" href="@Url.Action("Profile", "Account")">Min profil</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="@Url.Action("Logout", "Account")" method="post" id="logoutForm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Logga ut</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#loginModal">Logga in</button>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-primary">Skapa konto</a>
                        }
                        
                        <button id="theme-toggle-btn" class="ms-3">
                            <svg id="moon" viewBox="0 0 30 30">
                                <path d="M0 0 C0.99 0.33 1.98 0.66 3 1 C2.94199219 1.60328125 2.88398438 2.2065625 2.82421875 2.828125 C2.49648775 8.06650087 2.49648775 8.06650087 4.9375 12.5625 C9.05085562 14.49325876 12.53358557 14.35030701 17 14 C16.79164195 17.64626587 15.99170491 19.00957126 13.5625 21.8125 C10.03583149 24.48936887 6.74703216 24.70932131 2.41015625 24.5 C-1.5271311 23.68318836 -3.28634241 21.92240049 -6 19 C-7.86233425 15.27533151 -7.57130829 11.05504687 -7 7 C-5.3279253 3.87421857 -3.2143765 1.60718825 0 0 Z " fill="none" stroke="gray" stroke-width="3" transform="translate(10,3)" />
                            </svg>
                            <svg id="sun" viewBox="0 0 50 50">
                                <path d="M0 0 C3.125 1.875 3.125 1.875 5 5 C5.98876625 10.02622846 5.7769173 13.70513784 3.125 18.125 C-1.29486216 20.7769173 -4.97377154 20.98876625 -10 20 C-13.125 18.125 -13.125 18.125 -15 15 C-15.98876625 9.97377154 -15.7769173 6.29486216 -13.125 1.875 C-8.70513784 -0.7769173 -5.02622846 -0.98876625 0 0 Z " fill="none" stroke="grey" stroke-width="3" transform="translate(30,15)" />
                                <path d="M0 0 C2.88437779 1.29299694 4.87219421 2.65941363 7 5 C6.67 5.99 6.34 6.98 6 8 C3.11562221 6.70700306 1.12780579 5.34058637 -1 3 C-0.67 2.01 -0.34 1.02 0 0 Z " fill="grey" stroke-width="3" transform="translate(34,33)" />
                                <path d="M0 0 C0.99 0.33 1.98 0.66 3 1 C1.70700306 3.88437779 0.34058637 5.87219421 -2 8 C-2.99 7.67 -3.98 7.34 -5 7 C-3.70700306 4.11562221 -2.34058637 2.12780579 0 0 Z " fill="grey" stroke-width="3" transform="translate(14,33)" />
                                <path d="M0 0 C0.99 0.33 1.98 0.66 3 1 C1.70700306 3.88437779 0.34058637 5.87219421 -2 8 C-2.99 7.67 -3.98 7.34 -5 7 C-3.70700306 4.11562221 -2.34058637 2.12780579 0 0 Z " fill="grey" stroke-width="3" transform="translate(38,9)" />
                                <path d="M0 0 C2.88437779 1.29299694 4.87219421 2.65941363 7 5 C6.67 5.99 6.34 6.98 6 8 C3.11562221 6.70700306 1.12780579 5.34058637 -1 3 C-0.67 2.01 -0.34 1.02 0 0 Z " fill="grey" stroke-width="3" transform="translate(10,9)" />
                                <path d="M0 0 C2.97 0 5.94 0 9 0 C9 0.66 9 1.32 9 2 C6.03 2 3.06 2 0 2 C0 1.34 0 0.68 0 0 Z " fill="grey" stroke-width="3" transform="translate(37,24)" />
                                <path d="M0 0 C2.97 0 5.94 0 9 0 C9 0.66 9 1.32 9 2 C6.03 2 3.06 2 0 2 C0 1.34 0 0.68 0 0 Z " fill="grey" stroke-width="3" transform="translate(3,24)" />
                                <path d="M0 0 C0.66 0 1.32 0 2 0 C2 2.64 2 5.28 2 8 C1.34 8 0.68 8 0 8 C0 5.36 0 2.72 0 0 Z " fill="grey" stroke-width="3" transform="translate(24,38)" />
                                <path d="M0 0 C0.66 0 1.32 0 2 0 C2 2.64 2 5.28 2 8 C1.34 8 0.68 8 0 8 C0 5.36 0 2.72 0 0 Z " fill="grey" stroke-width="3" transform="translate(24,4)" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
        
        <div class="search-container p-3 mt-3 text-center">
            <div class="search-field">
                <label for="search" class="visually-hidden">Sök efter produkter:</label>
                <input type="text" id="search" placeholder="Sök efter produkt..." class="rounded-4 p-2" />
            </div>
        </div>
    </header>

    <main id="content" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer box-shadow text-center py-3">
        <div class="container">
            <span>&copy; 2025 - TechPulse</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="~/js/GSAP.js"></script>
    <script src="~/js/theme.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/search.js"></script>
    
    <script>
    $(document).ready(function() {
        $("#loginForm").on("submit", function(e) {
            e.preventDefault();
            $.ajax({
                url: $(this).attr("action"),
                type: "POST",
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        window.location.reload();
                    } else {
                        $("#loginError").text(response.message).removeClass("d-none");
                    }
                },
                error: function() {
                    $("#loginError").text("Ett fel uppstod. Försök igen.").removeClass("d-none");
                }
            });
        });
    });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
