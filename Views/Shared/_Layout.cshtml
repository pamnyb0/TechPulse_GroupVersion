<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title | TechPulse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechPulse.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/icons/globe.png")" />
</head>

<body class="light-mode d-flex flex-column vh-100">
    @{
        var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";
        var username = Context.Session.GetString("Username");
        var userId = Context.Session.GetString("UserId");
        var profileImageUrl = isLoggedIn ?
            (Context.Session.GetString("ProfileImageUrl") ?? "~/images/default-profile.jpg") :
            "~/images/default-profile.jpg";
    }

    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center" id="loginModalLabel">Logga in</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="post" asp-controller="Login" asp-action="Index" id="loginForm">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label for="Username">Användarnamn eller e-post:</label>
                            <input type="text" id="Username" name="Username" class="form-control" required />
                            <small id="usernameError" class="text-danger mt-2" style="display: none;">Du måste fylla i fältet.</small>
                        </div>

                        <div class="form-group mt-3">
                            <label for="Password">Lösenord:</label>
                            <input type="password" id="Password" name="Password" class="form-control" required />
                            <small id="passwordError" class="text-danger mt-2" style="display: none;">Du måste fylla i fältet.</small>
                        </div>

                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe">
                            <label class="form-check-label" for="rememberMe">Håll mig inloggad</label>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary w-100">Logga in</button>
                        </div>

                        <div class="modal-account mt-3 text-center">
                            <a href="@Url.Action("Create", "CreateAccount")" class="pulse-text" aria-label="Skapa konto">Skapa konto</a>
                            <span class="mx-2">|</span>
                            <a href="@Url.Action("Index", "ForgottenPassword")" class="pulse-text" aria-label="Glömt lösenord?">Glömt lösenord?</a>
                        </div>

                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-danger mt-3">
                                @TempData["Message"]
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    Tech<span class="pulse-text">Pulse</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" 
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")">
                                <i class="bi bi-house-door"></i> Start
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Shop", "Home")">
                                <i class="bi bi-shop"></i> Butik
                            </a>
                        </li>
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Cart")">
                                    <i class="bi bi-cart"></i> Varukorg
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Orders")">
                                    <i class="bi bi-box"></i> Mina ordrar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Publish", "Home")">
                                    <i class="bi bi-pencil-square"></i> Publicera
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (!isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">
                                    <i class="bi bi-box-arrow-in-right"></i> Logga in
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@Url.Content(profileImageUrl)" alt="Profilbild" class="profile-image" />
                                    @username
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Edit", "CreateAccount", new { id = userId })">
                                            <i class="bi bi-person"></i> Min profil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "Orders")">
                                            <i class="bi bi-box"></i> Mina ordrar
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Logga ut
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <button id="theme-toggle-btn" class="btn btn-link nav-link" aria-label="Toggle theme">
                                <i class="bi bi-moon-stars theme-icon-moon"></i>
                                <i class="bi bi-sun theme-icon-sun"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="footer box-shadow py-3">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year - TechPulse</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
