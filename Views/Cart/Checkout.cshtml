@model TechPulse.Models.ShoppingCart
@{
    ViewData["Title"] = "Kassa";
    var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";
}

<div class="container my-5">
    <h1 class="mb-4">Kassa</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info mb-4">
            @TempData["Message"]
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Beställningsdetaljer</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Produkt</th>
                                    <th>Pris</th>
                                    <th>Antal</th>
                                    <th>Totalt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.Product?.Name</td>
                                        <td>@item.Price.ToString("C0")</td>
                                        <td>@item.Quantity</td>
                                        <td>@((item.Price * item.Quantity).ToString("C0"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Sammanfattning</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Delsumma:</span>
                        <span>@Model.GetTotal().ToString("C0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Frakt:</span>
                        <span>0 kr</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold">Totalt:</span>
                        <span class="fw-bold">@Model.GetTotal().ToString("C0")</span>
                    </div>

                    @if (!isLoggedIn)
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Du måste <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal">logga in</a> för att slutföra köpet.
                        </div>
                    }

                    <div id="orderErrorMessage" class="alert alert-danger mb-3" style="display: none;"></div>

                    <form id="checkoutForm" method="post">
                        @Html.AntiForgeryToken()
                        <button id="placeOrderBtn" type="submit" class="btn btn-primary w-100" @(!isLoggedIn ? "disabled" : "")>
                            Slutför köp
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#checkoutForm").submit(function (e) {
                e.preventDefault();
                
                $("#placeOrderBtn").prop("disabled", true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processar...');
                
                $("#orderErrorMessage").hide();
                
                $.ajax({
                    url: '@Url.Action("PlaceOrder", "Cart")',
                    type: 'POST',
                    data: $(this).serialize() + '&clearCart=true',
                    success: function (response) {
                        updateCartCount(0);
                        
                        clearCartCompletely();
                        
                        localStorage.setItem('cartCleared', 'true');
                        
                        window.location.replace('@Url.Action("Profile", "Account")?cartCleared=true');
                    },
                    error: function () {
                        updateCartCount(0);
                        clearCartCompletely();
                        localStorage.setItem('cartCleared', 'true');
                        window.location.replace('@Url.Action("Profile", "Account")?cartCleared=true');
                    }
                });
            });
        });
        
        function clearCartCompletely() {
            try {
                sessionStorage.removeItem('Cart');
                sessionStorage.removeItem('cart');
                sessionStorage.setItem('Cart', JSON.stringify({ Items: [] }));
            } catch (e) {
                console.error('Error clearing cart from sessionStorage:', e);
            }
            
            sessionStorage.setItem('forceEmptyCart', 'true');
        }
        
        function updateCartCount(count) {
            const cartBadge = document.querySelector('.position-absolute.top-0.start-100.translate-middle.badge.rounded-pill.bg-danger');
            if (cartBadge) {
                if (count > 0) {
                    cartBadge.textContent = count;
                    cartBadge.style.display = 'inline-block';
                } else {
                    cartBadge.parentNode.removeChild(cartBadge);
                }
            }
        }
    </script>
} 