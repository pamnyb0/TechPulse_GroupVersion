@model TechPulse.Models.ShoppingCart
@{
    ViewData["Title"] = "Varukorg";
}

<div class="container my-5">
    <h1 class="mb-4">Varukorg</h1>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">
            Din varukorg är tom. <a href="@Url.Action("Index", "Product")">Fortsätt handla</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Produkt</th>
                        <th>Pris</th>
                        <th>Antal</th>
                        <th>Totalt</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                    {
                                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="img-thumbnail me-3" style="max-width: 60px;">
                                    }
                                    <div>
                                        <h6 class="mb-0">@item.Product?.Name</h6>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Price.ToString("C0")</td>
                            <td>@item.Quantity</td>
                            <td>@((item.Price * item.Quantity).ToString("C0"))</td>
                            <td>
                                <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductId })" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end"><strong>Totalt:</strong></td>
                        <td><strong>@Model.GetTotal().ToString("C0")</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i> Fortsätt handla
            </a>
            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-primary">
                Gå till kassan <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    }
</div> 